# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.
PORT=3000

# Master key untuk membungkus kunci per file (32 byte = 64 karakter hex).
# Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Kalau key ini hilang, semua file terenkripsi tidak bisa dibuka lagi.
FISIOVAULT_MASTER_KEY=
